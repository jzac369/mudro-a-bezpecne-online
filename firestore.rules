rules_version = '2';

// Prístupový model:
// - Verejnosť: číta iba `workshops` (verejné info o kurzoch).
// - Prihlásený účastník (custom token s claim `codeId`): číta/zapisuje
//   výhradne vlastné dokumenty v `progress`, `quizResults`, `sessions`,
//   identifikované jeho vlastným `codeId`.
// - `orders` a `accessCodes` zapisujú výhradne Cloud Functions (Admin SDK
//   obchádza tieto pravidlá) a číta administrátor (custom claim `admin: true`).
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function isOwnCode(codeId) {
      return request.auth != null && request.auth.token.codeId == codeId;
    }

    function isOwnChat(chatId) {
      return request.auth != null &&
        get(/databases/$(database)/documents/chats/$(chatId)).data.visitorUid == request.auth.uid;
    }

    match /workshops/{workshopId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Referencie/testimonials na úvodnej stránke — verejne čitateľné,
    // upravuje len administrátor (bez fotiek, len meno/vek/citát).
    match /testimonials/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Textové úpravy obrazoviek interaktívneho kurzu (nastavené v admin zóne).
    // Číta ktokoľvek prihlásený (účastník workshopu), zapisuje len administrátor.
    match /courseContent/{slideId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Všeobecné nastavenia platformy (napr. doba neaktivity pred odhlásením).
    match /settings/{settingId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isAdmin();
      allow create, delete: if false; // len Cloud Functions cez Admin SDK
      allow update: if isAdmin(); // napr. poznámka administrátora v Registráciách
    }

    // Archív vymazaných registrácií — zapisuje len deleteRegistrations
    // cez Admin SDK, číta administrátor.
    match /deletedRegistrations/{orderId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Ochrana pred zneužitím prístupového kódu (opakované nesprávne pokusy) —
    // zapisuje len verifyCode cez Admin SDK, číta administrátor.
    match /loginAttempts/{attemptId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Denné počítadlo pre čísla faktúr (KUYYYYMMDD001…) — potvrdenie o zaplatení
    // (UHYYYYMMDD001…) je odvodené z toho istého čísla, vlastné počítadlo nemá.
    match /invoiceCounters/{dayKey} {
      allow read, write: if isAdmin();
    }

    // Audit log úprav mena/priezviska/e-mailu registrácie — zapisuje len
    // updateOrderContact cez Admin SDK, číta administrátor.
    match /orderAuditLog/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Log prihlásení do admin zóny a zmien nastavení — píše priamo admin
    // klient (nie je to citlivá operácia vyžadujúca Admin SDK), je to
    // nemenný záznam (create only, žiadny update/delete).
    match /activityLog/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    match /accessCodes/{codeId} {
      allow read: if isAdmin() || isOwnCode(codeId);
      allow create, delete: if false; // len Cloud Functions cez Admin SDK
      allow update: if isAdmin(); // napr. deaktivácia kódu z admin zóny
    }

    match /progress/{codeId} {
      allow read: if isAdmin() || isOwnCode(codeId);
      allow write: if isOwnCode(codeId);
    }

    match /quizResults/{resultId} {
      allow read: if isAdmin() || isOwnCode(resource.data.codeId);
      allow create: if isOwnCode(request.resource.data.codeId);
      allow update, delete: if false; // výsledky sa neprepisujú, len pridávajú
    }

    match /sessions/{sessionId} {
      allow read: if isAdmin() || isOwnCode(resource.data.codeId);
      allow create: if isOwnCode(request.resource.data.codeId);
      allow update: if isOwnCode(resource.data.codeId);
      allow delete: if false;
    }

    match /feedback/{feedbackId} {
      allow read: if isAdmin();
      allow create: if isOwnCode(request.resource.data.codeId);
      allow update, delete: if false;
    }

    // Živý chat "Potrebujem pomoc". Návštevník (aj anonymne prihlásený cez
    // signInAnonymously) vidí a píše len do vlastnej konverzácie; admin vidí
    // a odpovedá do všetkých.
    match /chats/{chatId} {
      allow read: if isAdmin() || (request.auth != null && resource.data.visitorUid == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.visitorUid == request.auth.uid;
      allow update: if isAdmin() || (request.auth != null && resource.data.visitorUid == request.auth.uid);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isAdmin() || isOwnChat(chatId);
        allow create: if isAdmin() || isOwnChat(chatId);
        allow update, delete: if false;
      }
    }

    // Prítomnosť administrátora (online/offline) — verejne čitateľné, aby
    // chat widget vedel rozhodnúť medzi živým chatom a "zanechajte správu".
    match /presence/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Rezervácie konzultácií — zapisujú výhradne Cloud Functions
    // (getConsultationAvailability/bookConsultation), číta administrátor.
    match /consultationBookings/{bookingId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Zľavové kódy — spravuje administrátor priamo z admin zóny; overovanie
    // a započítanie použitia (usedCount) pri objednávke robí createOrder
    // cez Admin SDK, ktorý tieto pravidlá obchádza.
    match /discountCodes/{code} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // SMTP prihlasovacie údaje (vrátane hesla) na odosielanie faktúr a
    // potvrdení o zaplatení. Zámerne READ AJ WRITE VŽDY false — číta a
    // zapisuje výhradne Admin SDK cez getEmailSettings/saveEmailSettings,
    // ktoré heslo z odpovede vynechávajú. Priamy klientský prístup
    // (aj adminovi) by heslo posielal do prehliadača zbytočne.
    match /emailConfig/{docId} {
      allow read, write: if false;
    }

    // Log odoslaných e-mailov (kód, faktúra, POZ, poukaz) — číta sa cez
    // funkciu listSentEmails (Admin SDK), zapisuje výhradne server.
    match /mail/{mailId} {
      allow read, write: if false;
    }
  }
}
