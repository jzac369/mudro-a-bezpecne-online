rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Prezentácie ku kurzom (PDF/PPT) — nahráva len administrátor,
    // číta ktokoľvek prihlásený (admin aj účastník kurzu).
    match /presentations/{workshopId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
