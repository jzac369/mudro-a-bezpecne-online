rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Prezentácie, brožúrky a podpisy lektora ku kurzom — nahráva len
    // administrátor, číta ktokoľvek prihlásený (admin aj účastník kurzu).
    //
    // `{allPaths=**}` zahŕňa aj podpriečinky. Potrebujeme ich preto, lebo
    // popri samotnom PDF ukladáme aj jednotlivé strany pripravené na
    // listovanie (napr. brochures/kurz/1234_strany/page-001.jpg).
    match /presentations/{workshopId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
    match /brochures/{workshopId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
    match /signatures/{workshopId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // Logo organizácie (zobrazuje sa napr. na certifikáte) — jedno, spoločné
    // pre celý web, nie viazané na konkrétny kurz.
    match /branding/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
